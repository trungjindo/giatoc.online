# React Router dùng client-side routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Chuyển hướng lưu trữ hình ảnh đa tenant sang serve_storage.php
  RewriteRule ^api/storage/(.+)$ api/serve_storage.php?path=$1 [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cấu hình Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
